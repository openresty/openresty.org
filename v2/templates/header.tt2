<header role="header">
        <p class="site-name left">
            <a href=".">
                <img src="/images/logo.webp" width="64" alt="OpenResty logo" loading="eager">
            </a>
        </p>

        <p class="site-name left">
                <a href=".">OpenResty<span class="trade">&reg;</span></a>
                <small>[% c.l("Scalable Web Platform by Extending NGINX with Lua") %]</small>
        </p><!-- / site-name -->
        <p class="right link">
                <a href="https://github.com/openresty/" title="Contribute on GitHub">
                        <img src="/images/ico-github.webp" alt="GitHub" loading="eager">
                        <span class="link-title">[% c.l("Contribute on GitHub") %]</span>
                </a>
                <a href="https://forum.openresty.us/" title="[% c.l("Official Forum") %]">
                        <img class="dark-img" src="/images/flarum.webp" alt="OpenResty Forum" loading="eager">
                        <span class="link-title">[% c.l("Official Forum") %]</span>
                </a>
                <a role="button" href="https://openresty.com/en/xray/request-demo/?src=org_top" class="enterprise-button" type="button" title="[% c.l("Try OpenResty XRay") %]">
                        <img src="/images/rocket.svg" alt="Try OpenResty XRay" loading="eager">
                        <span class="link-title">[% c.l("Try OpenResty XRay") %]</span>
                </a>
        </p><!-- / links -->
</header>
